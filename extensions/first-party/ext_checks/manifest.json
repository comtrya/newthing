{
  "schemaVersion": "comtrya.extension/v1",
  "id": "ext_checks",
  "name": "checks",
  "displayName": "Checks",
  "version": "0.1.0",
  "publisher": "comtrya-dev",
  "platformWitVersion": "0.1.0",
  "perExtensionWit": "wit",
  "wasmComponent": "dist/ext_checks.wasm",
  "witWorld": "ext-checks",
  "ui": {
    "manifest": "ui/manifest.json"
  },
  "routePrefix": "checks",
  "runtime": {
    "resolver": "platform-wit-extension",
    "outputType": "comtrya.checks/summary.v1"
  },
  "contributes": {
    "resourceKinds": [{ "name": "check-run", "prefix": "chk" }],
    "collections": [
      {
        "name": "check_runs",
        "ownerExtension": "ext_checks",
        "indexes": [
          { "name": "by_repository_commit_name", "fields": ["repositoryID", "commitOID", "name"], "unique": true },
          { "name": "by_repository_required", "fields": ["repositoryID", "required"], "unique": false }
        ],
        "demoSeed": {
          "source": "checks",
          "idPrefix": "check_run",
          "resource": "repository",
          "resourceRefs": ["repository"],
          "addRepositoryId": true,
          "wasmRoute": {
            "extensionId": "ext_checks",
            "interfaceName": "checks",
            "opName": "record-check"
          }
        }
      }
    ],
    "slots": [
      { "slot": "repository.checks", "element": "comtrya-checks-board", "priority": 100 }
    ]
  },
  "hostImports": [
    "storage.read", "storage.write",
    "time", "ids", "log"
  ],
  "allowedEmits": [],
  "allowedEventReads": [],
  "allowedCrossCalls": [],
  "reactor": {
    "allowedMutations": [],
    "allowedEmits": []
  }
}
