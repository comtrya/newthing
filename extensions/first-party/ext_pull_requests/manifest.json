{
  "schemaVersion": "comtrya.extension/v1",
  "id": "ext_pull_requests",
  "name": "pull-requests",
  "displayName": "Pull Requests",
  "version": "0.1.0",
  "publisher": "comtrya-dev",
  "platformWitVersion": "0.1.0",
  "perExtensionWit": "wit",
  "wasmComponent": "dist/ext_pull_requests.wasm",
  "witWorld": "ext-pull-requests",
  "routePrefix": "pulls",
  "ui": { "manifest": "ui/manifest.json" },
  "runtime": {
    "resolver": "platform-wit-extension",
    "outputType": "comtrya.pull-requests/summary.v1"
  },
  "contributes": {
    "cueSchemas": [
      {
        "id": "pulls",
        "snippet": "package comtrya\n\n// Per-Project pull-request policy. Read by ext_pull_requests; the\n// kernel and other extensions do not interpret these fields.\n#Pulls: {\n  autoMerge?:      bool | *false\n  requiredChecks?: [...string]\n  reviewers?:      [...string]\n}\n\n#Project: { pulls?: #Pulls }\n"
      }
    ],
    "resourceKinds": [{ "name": "pull-request", "prefix": "pul", "scope": "repository" }],
    "collections": [
      {
        "name": "pull_requests",
        "ownerExtension": "ext_pull_requests",
        "indexes": [
          { "name": "by_repository_state_updated", "fields": ["repositoryId", "state", "updatedAt"], "unique": false },
          { "name": "by_repository_number", "fields": ["repositoryId", "number"], "unique": true }
        ]
      },
      {
        "name": "ext_pull_requests_meta",
        "ownerExtension": "ext_pull_requests",
        "indexes": [
          { "name": "by_id", "fields": ["id"], "unique": true }
        ]
      }
    ],
    "relationshipTypes": [
      {
        "id": "ext_pull_requests.closes",
        "kind": "comtrya://rel/com.comtrya.pulls/closes",
        "sourceKinds": ["pull-request"],
        "targetKinds": ["issue"],
        "outgoingLabel": "closes",
        "incomingLabel": "closed by",
        "order": 10
      }
    ]
  },
  "hostImports": [
    "storage.read", "storage.write",
    "relations.read",
    "events.write",
    "identity", "time", "ids", "ops", "log"
  ],
  "allowedEmits": [
    "dev.comtrya.pull-request.created",
    "dev.comtrya.pull-request.merged",
    "dev.comtrya.pull-request.closed"
  ],
  "allowedEventReads": [],
  "requiresExtensionPoints": [
    { "provider": "ext_issues", "point": "issue-linkage", "version": 1 }
  ],
  "dispatchRoutes": [
    { "op": "pulls.create-pull", "scope": "repository", "derive": { "strategy": "payloadField", "field": "repository" } },
    { "op": "pulls.list-pulls", "scope": "repository", "derive": { "strategy": "payloadField", "field": "repository" } }
  ],
  "reactor": {
    "scope": "repository",
    "subscribes": ["dev.comtrya.pull-request.merged"],
    "allowedMutations": ["ext_issues/issues.close-issue"],
    "allowedEmits": []
  }
}
