// ext_issues — per-extension WIT package.
//
// Depends on `comtrya:platform@0.1.0` for host imports. Exports an
// `issues` interface declaring the ops this extension supports.
// The kernel codegen reads this file at install time and produces the
// GraphQL dispatch table + a typed TS client.

package comtrya:ext-issues@0.1.13;

interface issues {
  use comtrya:platform/types@0.1.0.{id, uri, iso-timestamp, error};

  record issue {
    %id: id,
    repository: uri,
    title: string,
    body-markdown: string,
    state: issue-state,
    number: u64,
    author-ref: uri,
    created-at: iso-timestamp,
    updated-at: iso-timestamp,
    closed-at: option<iso-timestamp>,
    closed-by-ref: option<uri>,
    // 0.1.1 — free-form close reason supplied by `close-issue` input.
    // Cleared by `reopen-issue`. The GraphQL surface exposes it as
    // `stateReason`.
    state-reason: option<string>,
    // 0.1.3 — Project name this issue belongs to, derived from the
    // repo's `package comtrya` CUE config at open time. `None` means
    // the issue is unscoped (legacy, or repos without a comtrya
    // config). Project pages filter by this.
    project-name: option<string>,
    // 0.1.4 — free-form label set. Opening from a Project page
    // pre-fills these from the Project's `issues.defaultLabels` CUE
    // config; mutation/relabel happens via update-labels in 0.2.0.
    labels: list<string>,
    // 0.1.5 — opt-out for the PR merge reactor. Mirrors the
    // `issues.closeOnMerge` field on the Project's `package comtrya`
    // CUE config: `Some(false)` tells the reactor to skip auto-close
    // when a merged PR claims to close this issue. `None` keeps the
    // historical default (close).
    close-on-merge: option<bool>,
    // 0.1.6 — typed assignee URNs. Each entry is a canonical
    // `comtrya://{user,agent,bot,credential,team}/<slug>` ref
    // matching the kernel's `#Ref` family (introduced in iteration
    // 26). The new-issue form pre-fills assignees from the
    // Project's `owners` declared in `package comtrya` CUE, so
    // opening an issue against a Project routes it to the
    // Project's owners by default; the contributor can override.
    // The Projects spine + typed refs converge here.
    assignees: list<uri>,
  }

  variant issue-state {
    open,
    closed,
    reopened,
  }

  record issue-state-counts {
    open: u64,
    closed: u64,
  }

  record issue-triage-board-input {
    repository: uri,
    %limit: u32,
  }

  record issue-triage-card {
    issue: issue,
  }

  record issue-triage-column {
    key: string,
    label: string,
    count: u32,
    cards: list<issue-triage-card>,
  }

  record issue-triage-board {
    repository: uri,
    total: u32,
    columns: list<issue-triage-column>,
  }

  record issue-label-board-input {
    repository: uri,
    %limit: u32,
  }

  record issue-label-card {
    issue: issue,
  }

  record issue-label-column {
    key: string,
    label: string,
    count: u32,
    cards: list<issue-label-card>,
  }

  record issue-label-board {
    repository: uri,
    // Number of issues considered. Individual labeled cards can appear in
    // more than one column because an issue can carry multiple labels.
    total: u32,
    columns: list<issue-label-column>,
  }

  record issue-assignee-board-input {
    repository: uri,
    %limit: u32,
  }

  record issue-assignee-card {
    issue: issue,
  }

  record issue-assignee-column {
    key: string,
    label: string,
    assignee: option<uri>,
    count: u32,
    cards: list<issue-assignee-card>,
  }

  record issue-assignee-board {
    repository: uri,
    // Number of issues considered. Individual assigned cards can appear in
    // more than one column because an issue can have multiple assignees.
    total: u32,
    columns: list<issue-assignee-column>,
  }

  record issue-author-board-input {
    repository: uri,
    %limit: u32,
  }

  record issue-author-card {
    issue: issue,
  }

  record issue-author-column {
    key: string,
    label: string,
    author-ref: option<uri>,
    count: u32,
    cards: list<issue-author-card>,
  }

  record issue-author-board {
    repository: uri,
    total: u32,
    columns: list<issue-author-column>,
  }

  record issue-project-board-input {
    repository: uri,
    %limit: u32,
  }

  record issue-project-card {
    issue: issue,
  }

  record issue-project-column {
    key: string,
    label: string,
    project-name: option<string>,
    count: u32,
    cards: list<issue-project-card>,
  }

  record issue-project-board {
    repository: uri,
    total: u32,
    columns: list<issue-project-column>,
  }

  record issue-priority-board-input {
    repository: uri,
    %limit: u32,
  }

  record issue-priority-card {
    issue: issue,
    priority: option<string>,
    priority-label: option<string>,
  }

  record issue-priority-column {
    key: string,
    label: string,
    priority: option<string>,
    count: u32,
    cards: list<issue-priority-card>,
  }

  record issue-priority-board {
    repository: uri,
    total: u32,
    columns: list<issue-priority-column>,
  }

  record issue-milestone-board-input {
    repository: uri,
    %limit: u32,
  }

  record issue-milestone-card {
    issue: issue,
    milestone: option<string>,
    milestone-label: option<string>,
  }

  record issue-milestone-column {
    key: string,
    label: string,
    milestone: option<string>,
    count: u32,
    cards: list<issue-milestone-card>,
  }

  record issue-milestone-board {
    repository: uri,
    total: u32,
    columns: list<issue-milestone-column>,
  }

  record issue-workflow-board-input {
    repository: uri,
    %limit: u32,
  }

  record issue-workflow-card {
    issue: issue,
    workflow: option<string>,
    workflow-label: option<string>,
  }

  record issue-workflow-column {
    key: string,
    label: string,
    workflow: option<string>,
    count: u32,
    cards: list<issue-workflow-card>,
  }

  record issue-workflow-board {
    repository: uri,
    total: u32,
    columns: list<issue-workflow-column>,
  }

  record open-issue-input {
    repository: uri,
    title: string,
    body-markdown: string,
    // 0.1.3 — optional Project scope. The Project page passes its
    // own name when a contributor opens an issue from it. The kernel
    // does not validate this against the repo's CUE config — the
    // issue is stored as-is — but the UI uses it to scope listing.
    project-name: option<string>,
    // 0.1.4 — initial labels. The new-issue form passes the Project's
    // `issues.defaultLabels` from CUE plus any user-added labels.
    labels: list<string>,
    // 0.1.5 — initial closeOnMerge policy. Pre-filled by the new-issue
    // form from the Project's `issues.closeOnMerge` CUE config.
    close-on-merge: option<bool>,
    // 0.1.6 — initial assignees. The new-issue form pre-fills from
    // the Project's CUE `owners[]` (the typed `#Ref` URNs). The
    // user can edit before submitting.
    assignees: list<uri>,
  }

  record close-issue-input {
    %id: id,
    reason: option<string>,
    // 0.1.1 — actor URI to record on the closed issue. Defaults to
    // the calling principal when omitted.
    closed-by-ref: option<uri>,
  }

  // 0.1.7 — retroactive Project assignment. The new-issue form
  // stamps `project-name` at open time (iter 66), but issues
  // opened before that change or via API calls without a project
  // page can be untagged. This op lets the UI re-route an
  // existing issue to a Project (or clear it) by passing
  // `None`. The kernel emits `dev.comtrya.issues.project-changed`
  // so the workspace-wide per-Project counts (iter 65) refresh
  // live.
  record assign-project-input {
    %id: id,
    project-name: option<string>,
  }

  // 0.1.8 — partial-update for mutable issue fields. Only `Some`
  // fields are applied; `None` leaves the stored field unchanged.
  // `labels: Some([])` clears the label set; `labels: None` keeps
  // the existing labels. `title` is trimmed and validated the same
  // way as at open time (non-empty, at most MAX_TITLE_LEN bytes);
  // an empty or over-long title with `Some` value is rejected with
  // `bad-input`. `updated-at` is bumped on every successful write.
  record update-issue-input {
    %id: id,
    title: option<string>,
    body-markdown: option<string>,
    labels: option<list<string>>,
  }

  open-issue: func(input: open-issue-input) -> result<issue, error>;
  close-issue: func(input: close-issue-input) -> result<issue, error>;
  reopen-issue: func(%id: id) -> result<issue, error>;
  assign-project: func(input: assign-project-input) -> result<issue, error>;
  update-issue: func(input: update-issue-input) -> result<issue, error>;
  get-issue: func(%id: id) -> result<option<issue>, error>;
  list-issues: func(repository: uri, %limit: u32) -> result<list<issue>, error>;
  /// Familiar issue triage lanes for work queues. Closed issues are terminal;
  /// open issues that opt out of auto-close are separated from ordinary
  /// owner assignment lanes so maintainers can find manual follow-up work.
  triage-board: func(input: issue-triage-board-input) -> result<issue-triage-board, error>;
  /// Familiar issue taxonomy lanes. Unlabeled work is explicit, while labeled
  /// work appears once per label so maintainers can scan cross-cutting slices.
  label-board: func(input: issue-label-board-input) -> result<issue-label-board, error>;
  /// Familiar ownership lanes. Unassigned work is explicit, while assigned
  /// work appears once per assignee so owners can scan their active slice.
  assignee-board: func(input: issue-assignee-board-input) -> result<issue-assignee-board, error>;
  /// Familiar authored-by lanes. Closed issues are terminal, while active
  /// issues are grouped by their creator so contributors can scan their work.
  author-board: func(input: issue-author-board-input) -> result<issue-author-board, error>;
  /// Familiar product/project lanes. Unscoped work is explicit, while scoped
  /// issues are grouped by their stamped project name.
  project-board: func(input: issue-project-board-input) -> result<issue-project-board, error>;
  /// Familiar priority lanes derived from issue labels. Closed issues are
  /// terminal, while open issues use their highest priority label.
  priority-board: func(input: issue-priority-board-input) -> result<issue-priority-board, error>;
  /// Familiar milestone/release lanes derived from issue labels. Closed issues
  /// are terminal, while open issues use their first milestone or release label.
  milestone-board: func(input: issue-milestone-board-input) -> result<issue-milestone-board, error>;
  /// Familiar Kanban workflow lanes derived from issue labels. Closed issues
  /// are terminal, while open issues use status/stage/workflow labels when
  /// present and otherwise land in Untriaged.
  workflow-board: func(input: issue-workflow-board-input) -> result<issue-workflow-board, error>;
  by-ref-issue: func(%ref: uri) -> result<option<issue>, error>;
  by-refs-issue: func(refs: list<uri>) -> result<list<option<issue>>, error>;
  by-number-issue: func(workspace-id: id, number: u64) -> result<option<issue>, error>;
  state-counts-for-refs-issue: func(refs: list<uri>) -> result<issue-state-counts, error>;
}

world ext-issues {
  // Inherit every host import + the reactor export from the platform.
  include comtrya:platform/extension@0.1.0;
  export issues;
}
