// ext_issues — per-extension WIT package.
//
// Depends on `comtrya:platform@0.1.0` for host imports. Exports an
// `issues` interface declaring the ops this extension supports.
// The kernel codegen reads this file at install time and produces the
// GraphQL dispatch table + a typed TS client.

package comtrya:ext-issues@0.1.2;

interface issues {
  use comtrya:platform/types@0.1.0.{id, uri, iso-timestamp, error};

  record issue {
    %id: id,
    repository: uri,
    title: string,
    body-markdown: string,
    state: issue-state,
    number: u64,
    author-ref: uri,
    created-at: iso-timestamp,
    updated-at: iso-timestamp,
    closed-at: option<iso-timestamp>,
    closed-by-ref: option<uri>,
    // 0.1.1 — free-form close reason supplied by `close-issue` input.
    // Cleared by `reopen-issue`. The GraphQL surface exposes it as
    // `stateReason`.
    state-reason: option<string>,
  }

  variant issue-state {
    open,
    closed,
    reopened,
  }

  record issue-state-counts {
    open: u64,
    closed: u64,
  }

  record open-issue-input {
    repository: uri,
    title: string,
    body-markdown: string,
  }

  record close-issue-input {
    %id: id,
    reason: option<string>,
    // 0.1.1 — actor URI to record on the closed issue. Defaults to
    // the calling principal when omitted.
    closed-by-ref: option<uri>,
  }

  open-issue: func(input: open-issue-input) -> result<issue, error>;
  close-issue: func(input: close-issue-input) -> result<issue, error>;
  reopen-issue: func(%id: id) -> result<issue, error>;
  get-issue: func(%id: id) -> result<option<issue>, error>;
  list-issues: func(repository: uri, %limit: u32) -> result<list<issue>, error>;
  by-ref-issue: func(%ref: uri) -> result<option<issue>, error>;
  by-refs-issue: func(refs: list<uri>) -> result<list<option<issue>>, error>;
  by-number-issue: func(workspace-id: id, number: u64) -> result<option<issue>, error>;
  state-counts-for-refs-issue: func(refs: list<uri>) -> result<issue-state-counts, error>;
}

world ext-issues {
  // Inherit every host import + the reactor export from the platform.
  include comtrya:platform/extension@0.1.0;
  export issues;
}
