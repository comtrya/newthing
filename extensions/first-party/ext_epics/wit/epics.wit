// ext_epics — per-extension WIT.
//
// Epics are work-tracking aggregates that contain issues. The epic state
// machine is OPEN → IN-PROGRESS → AT-RISK → DONE / CANCELED, with
// transitions modelled explicitly in the `epic-state` variant.

package comtrya:ext-epics@0.1.4;

interface epics {
  use comtrya:platform/types@0.1.0.{id, uri, iso-timestamp, error};

  variant epic-state {
    planned,
    in-progress,
    at-risk,
    done,
    canceled,
  }

  record epic {
    %id: id,
    workspace: uri,
    title: string,
    body-markdown: string,
    state: epic-state,
    // 0.1.4 — per-workspace sequential number, analogous to issues.number.
    // Allocated at create time via a CAS counter in `ext_epics_meta`;
    // workspace-scoped so the first epic in each workspace is number 1.
    number: u32,
    target-date: option<string>,
    owner-ref: option<uri>,
    labels: list<string>,
    created-at: iso-timestamp,
    updated-at: iso-timestamp,
    closed-at: option<iso-timestamp>,
    // 0.1.1 — Project this epic belongs to, derived from the repo's
    // `package comtrya` CUE config at create time. Stamped by the UI
    // when opening from a Project page. `None` for unscoped epics.
    project-name: option<string>,
  }

  record create-epic-input {
    workspace: uri,
    title: string,
    body-markdown: string,
    owner-ref: option<uri>,
    target-date: option<string>,
    labels: list<string>,
    parent-epic-ref: option<uri>,
    // 0.1.1 — optional Project scope; same semantics as issues.
    project-name: option<string>,
  }

  record change-state-epic-input {
    %id: id,
    state: epic-state,
  }

  // 0.1.2 — retroactive Project assignment for epics. Mirrors
  // `ext_issues.assign-project` (iter 67). The kernel emits
  // `dev.comtrya.epic.project-changed` so the workspace-wide
  // per-Project counts (iter 65) refresh live without a re-scan.
  record assign-project-input {
    %id: id,
    project-name: option<string>,
  }

  record epic-progress {
    issues-open: u64,
    issues-closed: u64,
    child-epics-open: u64,
    child-epics-closed: u64,
    percent-complete: u64,
  }

  create-epic: func(input: create-epic-input) -> result<epic, error>;
  change-state-epic: func(input: change-state-epic-input) -> result<epic, error>;
  assign-project: func(input: assign-project-input) -> result<epic, error>;
  get-epic: func(%id: id) -> result<option<epic>, error>;
  list-epics: func(workspace: uri, %limit: u32) -> result<list<epic>, error>;
  by-ref-epic: func(ref: uri) -> result<option<epic>, error>;
  by-refs-epic: func(refs: list<uri>) -> result<list<option<epic>>, error>;
  progress-epic: func(ref: uri) -> result<epic-progress, error>;
  /// Issues that are members of this epic. Capped server-side at
  /// `min(limit, 1024)`; silently truncated beyond that. Per the
  /// per-extension list-op convention (see `docs/wit-platform-design.md`).
  issues-in-epic: func(ref: uri, %limit: u32) -> result<list<uri>, error>;
  /// Child epics nested under this epic. Same `min(limit, 1024)`
  /// truncation contract as `issues-in-epic`.
  children-of-epic: func(ref: uri, %limit: u32) -> result<list<uri>, error>;
}

world ext-epics {
  include comtrya:platform/extension@0.1.0;
  export epics;
}
