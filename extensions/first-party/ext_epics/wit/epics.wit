// ext_epics — per-extension WIT.
//
// Epics are work-tracking aggregates that contain issues. The epic state
// machine is PLANNED → IN-PROGRESS → AT-RISK → DONE / CANCELED, with
// transitions modelled explicitly in the `epic-state` variant.

package comtrya:ext-epics@0.1.8;

interface epics {
  use comtrya:platform/types@0.1.0.{id, uri, iso-timestamp, error};

  variant epic-state {
    planned,
    in-progress,
    at-risk,
    done,
    canceled,
  }

  record epic {
    %id: id,
    workspace: uri,
    title: string,
    body-markdown: string,
    state: epic-state,
    // 0.1.4 — per-workspace sequential number, analogous to issues.number.
    // Allocated at create time via a CAS counter in `ext_epics_meta`;
    // workspace-scoped so the first epic in each workspace is number 1.
    number: u32,
    target-date: option<string>,
    owner-ref: option<uri>,
    labels: list<string>,
    created-at: iso-timestamp,
    updated-at: iso-timestamp,
    closed-at: option<iso-timestamp>,
    // 0.1.1 — Project this epic belongs to, derived from the repo's
    // `package comtrya` CUE config at create time. Stamped by the UI
    // when opening from a Project page. `None` for unscoped epics.
    project-name: option<string>,
  }

  record create-epic-input {
    workspace: uri,
    title: string,
    body-markdown: string,
    owner-ref: option<uri>,
    target-date: option<string>,
    labels: list<string>,
    parent-epic-ref: option<uri>,
    // 0.1.1 — optional Project scope; same semantics as issues.
    project-name: option<string>,
  }

  record change-state-epic-input {
    %id: id,
    state: epic-state,
  }

  // 0.1.2 — retroactive Project assignment for epics. Mirrors
  // `ext_issues.assign-project` (iter 67). The kernel emits
  // `dev.comtrya.epic.project-changed` so the workspace-wide
  // per-Project counts (iter 65) refresh live without a re-scan.
  record assign-project-input {
    %id: id,
    project-name: option<string>,
  }

  // 0.1.5 — partial-update for mutable epic fields. Only `Some`
  // fields are applied; `None` leaves the stored field unchanged.
  // `labels: Some([])` clears labels; `labels: None` keeps them.
  // `title` is trimmed and validated the same way as at create time
  // (non-empty, at most MAX_TITLE_LEN bytes). `updated-at` is
  // bumped on every successful write.
  record update-epic-input {
    %id: id,
    title: option<string>,
    body-markdown: option<string>,
    owner-ref: option<string>,
    target-date: option<string>,
    labels: option<list<string>>,
  }

  record epic-progress {
    issues-open: u64,
    issues-closed: u64,
    child-epics-open: u64,
    child-epics-closed: u64,
    percent-complete: u64,
  }

  record roadmap-board-input {
    workspace: uri,
    %limit: u32,
  }

  record epic-roadmap-card {
    epic: epic,
    progress: epic-progress,
  }

  record epic-roadmap-column {
    key: string,
    label: string,
    count: u32,
    cards: list<epic-roadmap-card>,
  }

  record epic-roadmap-board {
    workspace: uri,
    total: u32,
    columns: list<epic-roadmap-column>,
  }

  record owner-board-input {
    workspace: uri,
    %limit: u32,
  }

  record epic-owner-card {
    epic: epic,
    progress: epic-progress,
  }

  record epic-owner-column {
    key: string,
    label: string,
    owner-ref: option<uri>,
    count: u32,
    cards: list<epic-owner-card>,
  }

  record epic-owner-board {
    workspace: uri,
    total: u32,
    columns: list<epic-owner-column>,
  }

  record project-board-input {
    workspace: uri,
    %limit: u32,
  }

  record epic-project-card {
    epic: epic,
    progress: epic-progress,
  }

  record epic-project-column {
    key: string,
    label: string,
    project-name: option<string>,
    count: u32,
    cards: list<epic-project-card>,
  }

  record epic-project-board {
    workspace: uri,
    total: u32,
    columns: list<epic-project-column>,
  }

  record target-board-input {
    workspace: uri,
    %limit: u32,
  }

  record epic-target-card {
    epic: epic,
    progress: epic-progress,
  }

  record epic-target-column {
    key: string,
    label: string,
    count: u32,
    cards: list<epic-target-card>,
  }

  record epic-target-board {
    workspace: uri,
    today: string,
    total: u32,
    columns: list<epic-target-column>,
  }

  create-epic: func(input: create-epic-input) -> result<epic, error>;
  change-state-epic: func(input: change-state-epic-input) -> result<epic, error>;
  assign-project: func(input: assign-project-input) -> result<epic, error>;
  update-epic: func(input: update-epic-input) -> result<epic, error>;
  get-epic: func(%id: id) -> result<option<epic>, error>;
  list-epics: func(workspace: uri, %limit: u32) -> result<list<epic>, error>;
  by-ref-epic: func(ref: uri) -> result<option<epic>, error>;
  by-refs-epic: func(refs: list<uri>) -> result<list<option<epic>>, error>;
  progress-epic: func(ref: uri) -> result<epic-progress, error>;
  /// Familiar roadmap lanes for planning surfaces. Each card carries the
  /// epic plus the same aggregate progress exposed by `progress-epic`, so
  /// UIs do not need an N+1 fan-out to render a roadmap board.
  roadmap-board: func(input: roadmap-board-input) -> result<epic-roadmap-board, error>;
  /// Familiar ownership lanes for planning surfaces. Unowned epics are
  /// explicit, while owned epics are grouped by their typed owner ref.
  owner-board: func(input: owner-board-input) -> result<epic-owner-board, error>;
  /// Familiar Project lanes for product planning surfaces. Unscoped
  /// epics stay visible instead of disappearing from Project views.
  project-board: func(input: project-board-input) -> result<epic-project-board, error>;
  /// Familiar target-date lanes for release planning. Completed epics
  /// stay separate from overdue/upcoming work, and untargeted epics
  /// remain visible as planning debt.
  target-board: func(input: target-board-input) -> result<epic-target-board, error>;
  /// Issues that are members of this epic. Capped server-side at
  /// `min(limit, 1024)`; silently truncated beyond that. Per the
  /// per-extension list-op convention (see `docs/wit-platform-design.md`).
  issues-in-epic: func(ref: uri, %limit: u32) -> result<list<uri>, error>;
  /// Child epics nested under this epic. Same `min(limit, 1024)`
  /// truncation contract as `issues-in-epic`.
  children-of-epic: func(ref: uri, %limit: u32) -> result<list<uri>, error>;
}

world ext-epics {
  include comtrya:platform/extension@0.1.0;
  export epics;
}
