{
  "schemaVersion": "comtrya.extension/v1",
  "id": "ext_epics",
  "name": "epics",
  "displayName": "Epics",
  "version": "0.1.0",
  "publisher": "comtrya-dev",
  "platformWitVersion": "0.1.0",
  "perExtensionWit": "wit",
  "wasmComponent": "dist/ext_epics.wasm",
  "witWorld": "ext-epics",
  "ui": { "manifest": "ui/manifest.json" },
  "routePrefix": "epics",
  "runtime": {
    "resolver": "platform-wit-extension",
    "outputType": "comtrya.epics/summary.v1"
  },
  "contributes": {
    "resourceKinds": [{ "name": "epic", "prefix": "epc" }],
    "cards": [{ "kind": "epic", "element": "comtrya-epic-card" }],
    "slots": [
      { "slot": "workspace.home.left", "element": "comtrya-epics-board", "priority": 100 }
    ],
    "routes": [{ "path": "/r/*/epics", "element": "comtrya-epics-page" }]
  },
  "hostImports": [
    "storage.read", "storage.write",
    "relations.read", "relations.write",
    "events.write",
    "time", "ids", "ops", "log"
  ],
  "allowedEmits": [
    "dev.comtrya.epic.created",
    "dev.comtrya.epic.state-changed"
  ],
  "allowedEventReads": ["ext_issues"],
  "allowedCrossCalls": [
    "ext_issues/issues.state-counts-for-refs-issue"
  ],
  "reactor": {
    "allowedMutations": [],
    "allowedEmits": []
  }
}
