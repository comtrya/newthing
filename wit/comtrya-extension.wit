package comtrya:extension;

// World an extension component implements.
//
// Hosts may rely on any subset of these imports being satisfied. Components
// that do not use a given host interface still declare the import; the host
// supplies a no-op implementation.
world extension {
  import host-log;
  import host-events;
  import host-storage;
  import host-git;
  import host-http;
  import host-secrets;
  import host-jobs;

  export extension-api;
}

// extension-api is the contract a component exports.
//
// The resolver protocol is JSON-shaped for v3. We will narrow it to typed
// records once the first-party extensions stabilize their schemas.
interface extension-api {
  record init-context {
    installation-id: string,
    extension-name: string,
    version: string,
    config-json: string,
  }

  init: func(ctx: init-context) -> result<_, string>;
  shutdown: func() -> result<_, string>;
  graphql-sdl: func() -> result<string, string>;

  record resolver-request {
    field-path: string,
    parent-json: option<string>,
    args-json: string,
    viewer-json: string,
    selection-json: string,
  }

  record resolver-response {
    result-json: string,
  }

  record resolver-batch-request {
    field-path: string,
    parents-json: string,
    args-json: string,
    viewer-json: string,
    selection-json: string,
  }

  record resolver-batch-response {
    results-json: string,
  }

  resolve: func(req: resolver-request) -> result<resolver-response, string>;
  resolve-batch: func(req: resolver-batch-request) -> result<resolver-batch-response, string>;
}

// host-log: structured log emission. Levels mirror tracing.
interface host-log {
  enum level {
    trace,
    debug,
    info,
    warn,
    error,
  }
  log: func(level: level, target: string, message: string, fields-json: string);
}

// host-events: emit CloudEvents into the host's durable outbox.
//
// The host validates the envelope; emit returns the resolved event id or
// rejects the envelope with a string error.
interface host-events {
  record envelope {
    type: string,
    source: string,
    subject: option<string>,
    data-json: string,
    correlation-id: option<string>,
  }
  emit: func(env: envelope) -> result<string, string>;
}

// host-storage: per-extension document store.
//
// One isolated SQLite database per installation, exposed through a small
// typed API. Migrations are owned by the extension manifest and applied by
// the host before init.
interface host-storage {
  record document {
    id: string,
    collection: string,
    revision: u64,
    body-json: string,
  }
  put: func(collection: string, id: string, body-json: string) -> result<document, string>;
  get: func(collection: string, id: string) -> result<option<document>, string>;
  delete: func(collection: string, id: string) -> result<bool, string>;
  query: func(collection: string, filter-json: string, limit: u32) -> result<list<document>, string>;
  kv-put: func(key: string, value: string) -> result<_, string>;
  kv-get: func(key: string) -> result<option<string>, string>;
  kv-delete: func(key: string) -> result<bool, string>;
}

// host-git: read-only Git access scoped to a specific repository.
//
// Extensions cannot list or open arbitrary repos. The host vends a repo
// handle by resource (future increment); for v3 we pass the repo id and
// the host resolves it.
interface host-git {
  record commit-summary {
    oid: string,
    parents: list<string>,
    author: string,
    committer: string,
    summary: string,
    timestamp: s64,
  }
  resolve-ref: func(repo-id: string, ref: string) -> result<string, string>;
  read-blob: func(repo-id: string, oid: string) -> result<list<u8>, string>;
  list-commits: func(repo-id: string, ref: string, limit: u32) -> result<list<commit-summary>, string>;
}

// host-http: outbound HTTP for extensions that talk to external services.
//
// Scoped by allowlist declared in the extension manifest. Host enforces.
interface host-http {
  record request {
    method: string,
    url: string,
    headers-json: string,
    body: option<list<u8>>,
  }
  record response {
    status: u16,
    headers-json: string,
    body: list<u8>,
  }
  fetch: func(req: request) -> result<response, string>;
}

// host-secrets: read-only access to host-managed secrets.
//
// Extensions declare named secret bindings in their manifest. The host
// vends only those keys.
interface host-secrets {
  get: func(name: string) -> result<string, string>;
}

// host-jobs: enqueue background work that the host's job runner executes.
//
// Useful for fan-out, webhooks, scheduled syncs. The host enforces a quota
// per installation.
interface host-jobs {
  record submission {
    kind: string,
    queue: string,
    payload-json: string,
    not-before: option<s64>,
  }
  submit: func(job: submission) -> result<string, string>;
}
