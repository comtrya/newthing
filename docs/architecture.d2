direction: right

title: |md
  # Comtrya v3 — Component Architecture
  Solid arrows = request, dashed arrows = response/event
| {
  near: top-center
  shape: text
}

# ────────────────────────────────────────────────────────────────
# WEB (browser)
# ────────────────────────────────────────────────────────────────
web: "Web — Browser" {
  style: {
    fill: "#E8F4FD"
    stroke: "#1E6FBA"
    stroke-width: 3
    border-radius: 12
  }

  shell: "Vue SPA Shell" {
    style.fill: "#FFFFFF"

    router: "Router (shell-owned)\n/, /r/<groups>/<repo>,\n/new, /settings, /health\n+ /x/<prefix>/... → ExtensionRoute"
    slots: "Generic slot regions\nrepository.main, repository.sidebar,\nhome.your-work, home.activity, …"
    sdk: "Extension SDK\nwidget registry · route registry ·\ncard registry · user-layout"
    gql_client: "Shared GraphQL client\n(getGraphQLClient)"
    git_client: "Git client\n(clone / fetch)"
    auth_client: "Auth / session"
    user_layout: "User layout overlay\n(localStorage today,\nfederated GraphQL soon)" {
      style.stroke-dash: 3
    }
  }

  ext_ui: "Extension UI bundles (ESM)" {
    style: {
      fill: "#FFFFFF"
      stroke-dash: 3
    }
    issues_ui: "ext_issues\nregisterWidget · /x/issues/..."
    epics_ui: "ext_epics\nregisterWidget · /x/epics/..."
    pr_ui: "ext_pull_requests\nregisterWidget · /x/pulls/..."
    checks_ui: "ext_checks\nregisterWidget · /x/checks/..."
    home_ui: "ext_workspace_home\nregisterWidget"
  }
}

# ────────────────────────────────────────────────────────────────
# SERVER / HOST (Rust)
# ────────────────────────────────────────────────────────────────
server: "Server / Host — crates/server (Rust)" {
  style: {
    fill: "#FFF4E0"
    stroke: "#B57400"
    stroke-width: 3
    border-radius: 12
  }

  edge: "HTTP edge" {
    style.fill: "#FFFFFF"
    health: "/healthz · /readyz"
    auth: "Auth / session\n(OIDC, operator code)"
    graphql: "GraphQL\n/graphql"
    assets: "Asset server\n/forge-ui/<module-token>/files/..."
    git_http: "Git Smart HTTP v2\n(comtrya-git-http)\nupload-pack only"
  }

  dispatch: "WIT dispatch table\n(generated by crates/wit-codegen)" {
    style.fill: "#FFE9B3"
  }

  manifest_gate: "Manifest allowlists\nimports · events · ops.invoke · reactors" {
    style: {
      fill: "#FFE9B3"
      stroke-dash: 3
    }
  }

  imports: "Host imports (platform 0.1.0)" {
    style.fill: "#FFE9B3"
    storage: "storage"
    relations: "relations"
    comments: "comments"
    events: "events"
    identity: "identity"
    time_ids: "time · ids"
    ops_invoke: "ops.invoke\n(cross-extension)"
    log: "log"
  }

  wasmtime: "Wasmtime — Component Model runtime" {
    style: {
      fill: "#FFD680"
      stroke-width: 2
    }
  }

  reactors: "Reactor dispatcher\n(subscribed events → exports)" {
    style.fill: "#FFE9B3"
  }
}

# ────────────────────────────────────────────────────────────────
# EXTENSIONS (WASM components)
# ────────────────────────────────────────────────────────────────
ext: "Extensions — WASM components (dist/<id>.wasm)" {
  style: {
    fill: "#EAF7E6"
    stroke: "#3F8B2E"
    stroke-width: 3
    border-radius: 12
  }

  issues: "ext_issues"
  epics: "ext_epics"
  pr: "ext_pull_requests"
  checks: "ext_checks"
  home: "ext_workspace_home"
}

# ────────────────────────────────────────────────────────────────
# DATABASES / STORAGE
# ────────────────────────────────────────────────────────────────
db: "Storage — COMTRYA_DATA_DIR" {
  style: {
    fill: "#F4E6F7"
    stroke: "#7B2EB5"
    stroke-width: 3
    border-radius: 12
  }

  ext_store: "Extension storage" {
    schema: "schema.json"
    docs: "documents.jsonl"
    events: "events.jsonl"
  }

  git: "Bare Git repositories\nrepositories/<group>/<repo>.git" {
    shape: cylinder
  }

  meta: "metadata/\nevents.jsonl\naudit.jsonl" {
    shape: page
  }
}

# ════════════════════════════════════════════════════════════════
# REQUEST / RESPONSE FLOWS
# ════════════════════════════════════════════════════════════════

# ── Browser ⇄ Server (HTTP) ─────────────────────────────────────
web.shell.gql_client -> server.edge.graphql: "POST /graphql" {
  style.stroke: "#1E6FBA"
  style.stroke-width: 2
}
server.edge.graphql -> web.shell.gql_client: "JSON response" {
  style.stroke: "#1E6FBA"
  style.stroke-dash: 4
}

web.shell.git_client -> server.edge.git_http: "GET /info/refs\nPOST /git-upload-pack" {
  style.stroke: "#1E6FBA"
  style.stroke-width: 2
}
server.edge.git_http -> web.shell.git_client: "pkt-line" {
  style.stroke: "#1E6FBA"
  style.stroke-dash: 4
}

web.shell.sdk -> server.edge.assets: "GET /forge-ui/<module-token>/files/index.js" {
  style.stroke: "#1E6FBA"
  style.stroke-width: 2
}
server.edge.assets -> web.ext_ui: "ESM bundle" {
  style.stroke: "#1E6FBA"
  style.stroke-dash: 4
}

web.shell.auth_client -> server.edge.auth: "session exchange" {
  style.stroke: "#1E6FBA"
}

# ── Server: GraphQL → WASM dispatch ─────────────────────────────
server.edge.graphql -> server.dispatch: "resolve root field"
server.dispatch -> server.wasmtime: "invoke typed export"
server.wasmtime -> ext: "instantiate + call" {
  style.stroke: "#3F8B2E"
  style.stroke-width: 2
}
ext -> server.wasmtime: "return value" {
  style.stroke: "#3F8B2E"
  style.stroke-dash: 4
}

# ── Extensions → host imports (gated) ───────────────────────────
ext -> server.imports: "import calls" {
  style.stroke: "#3F8B2E"
}
server.imports -> server.manifest_gate: "allowlist check" {
  style.stroke-dash: 3
}

# ── Cross-extension via ops.invoke ──────────────────────────────
ext.pr -> server.imports.ops_invoke: "ops.invoke\next_issues/issues.close-issue" {
  style.stroke: "#3F8B2E"
  style.stroke-dash: 2
}
server.imports.ops_invoke -> ext.issues: "dispatched call" {
  style.stroke: "#3F8B2E"
  style.stroke-dash: 2
}

# ── Host imports ⇄ storage ──────────────────────────────────────
server.imports.storage -> db.ext_store: "read / write docs" {
  style.stroke: "#7B2EB5"
}
server.imports.events -> db.ext_store.events: "append event" {
  style.stroke: "#7B2EB5"
}
db.ext_store -> server.imports.storage: "rows" {
  style.stroke: "#7B2EB5"
  style.stroke-dash: 4
}

# ── Git path → bare repos ───────────────────────────────────────
server.edge.git_http -> db.git: "read refs / pack" {
  style.stroke: "#7B2EB5"
}
db.git -> server.edge.git_http: "objects" {
  style.stroke: "#7B2EB5"
  style.stroke-dash: 4
}

# ── Seed path ───────────────────────────────────────────────────
server.edge.health -> db.meta: "read seed (first boot)" {
  style.stroke: "#7B2EB5"
  style.stroke-dash: 3
}

# ── Reactor loop ────────────────────────────────────────────────
db.ext_store.events -> server.reactors: "appended event" {
  style.stroke: "#7B2EB5"
  style.stroke-dash: 2
}
server.reactors -> server.wasmtime: "dispatch to subscriber" {
  style.stroke: "#B57400"
  style.stroke-dash: 2
}

# ── Browser UI mounting (widgets / routes) ──────────────────────
web.shell.sdk -> web.ext_ui: "registerWidget · registerRoute · registerCard" {
  style.stroke: "#1E6FBA"
  style.stroke-dash: 3
}
web.shell.user_layout -> web.shell.slots: "override widget→slot binding" {
  style.stroke: "#1E6FBA"
  style.stroke-dash: 3
}
web.ext_ui -> web.shell.slots: "widgets resolve into generic slots" {
  style.stroke: "#1E6FBA"
  style.stroke-dash: 3
}
