target/
data/
.DS_Store
*.log
.env
.env.*
.envrc

# Per-extension build outputs from extensions/bundler/build-extension.sh.
# The bundler writes here on every build; most artifacts are derived
# from the component's Cargo.toml + wit/ inputs. The ext_issues WASM is
# tracked intentionally because the default kernel startup path loads it.
extensions/first-party/*/dist/*
!extensions/first-party/ext_issues/dist/
!extensions/first-party/ext_issues/dist/ext_issues.wasm
!extensions/first-party/ext_epics/dist/
!extensions/first-party/ext_epics/dist/ext_epics.wasm
!extensions/first-party/ext_pull_requests/dist/
!extensions/first-party/ext_pull_requests/dist/ext_pull_requests.wasm
!extensions/first-party/ext_checks/dist/
!extensions/first-party/ext_checks/dist/ext_checks.wasm
!extensions/first-party/ext_docs/dist/
!extensions/first-party/ext_docs/dist/ext_docs.wasm
!extensions/first-party/ext_workspace_home/dist/
!extensions/first-party/ext_workspace_home/dist/ext_workspace_home.wasm
!extensions/first-party/ext_sprints/dist/
!extensions/first-party/ext_sprints/dist/ext_sprints.wasm

# cargo-component regenerates this from the WIT on every build; treat
# it as generated, not source.
extensions/first-party/*/component/src/bindings.rs
extensions/first-party/*/wit/deps/
