---
import "../styles.css";

export const prerender = false;

const backend = process.env.FORGEPOINT_SERVER_URL ?? "http://127.0.0.1:8080";
const operatorCode = process.env.PUBLIC_FORGEPOINT_OPERATOR_CODE ?? "";
let initialRepo:
  | {
      title: string;
      commit: string;
      headOid: string;
      resource: string;
      refs: number;
      files: number;
      resolvers: number;
    }
  | undefined;

try {
  if (operatorCode) {
    const bootstrapResponse = await fetch(new URL("/graphql", backend), {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        query: "{ repository { id owner name currentCommit headOid refs files } extensionResolvers }",
      }),
    });
    if (!bootstrapResponse.ok) {
      throw new Error("repository bootstrap failed");
    }
    const bootstrap = await bootstrapResponse.json();
    const bootstrapRepository = bootstrap?.data?.repository;
    if (!bootstrapRepository?.id) {
      throw new Error("repository bootstrap did not return an id");
    }
    const requestedResource = `forgepoint://repository/${bootstrapRepository.id}`;

    const tokenResponse = await fetch(new URL("/auth/token-exchange", backend), {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        grantType: "urn:forgepoint:grant:operator-code",
        subjectToken: operatorCode,
        subjectTokenType: "urn:forgepoint:token-type:operator-code",
        requestedResource,
        requestedActions: ["graphql:read", "events:read", "git:read", "checks:read"],
      }),
    });
    const token = await tokenResponse.json();
    if (tokenResponse.ok && token.accessToken) {
      const graphqlResponse = await fetch(new URL("/graphql", backend), {
        method: "POST",
        headers: {
          "Authorization": `Bearer ${token.accessToken}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          query: "{ repository { id owner name currentCommit headOid refs files } extensionResolvers }",
        }),
      });
      const graphql = await graphqlResponse.json();
      const repository = graphql?.data?.repository;
      if (graphqlResponse.ok && repository) {
        initialRepo = {
          title: `${repository.owner} / ${repository.name}`,
          commit: repository.currentCommit,
          headOid: repository.headOid,
          resource: `forgepoint://repository/${repository.id}`,
          refs: repository.refs?.length ?? 0,
          files: repository.files?.length ?? 0,
          resolvers: graphql?.data?.extensionResolvers?.length ?? 0,
        };
      }
    }
  }
} catch {
  initialRepo = undefined;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgepoint</title>
  </head>
  <body>
    <main id="app" class="app-shell">
      <section class="loading-screen" aria-live="polite">
        <h1>Forgepoint</h1>
        {
          initialRepo ? (
            <p
              data-smoke="rendered-ui-live"
              data-smoke-head-oid={initialRepo.headOid}
              data-smoke-resource={initialRepo.resource}
            >
              {initialRepo.title} at {initialRepo.commit} with {initialRepo.refs} refs,{" "}
              {initialRepo.files} files, and {initialRepo.resolvers} Wasmtime resolvers.
            </p>
          ) : (
            <p>Starting interface...</p>
          )
        }
      </section>
    </main>
    <script src="../main.ts"></script>
  </body>
</html>
